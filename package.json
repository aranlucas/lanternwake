{
  "name": "lanternwake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317",
    "dev:portless": "portless run --name lanternwake vite",
    "build": "tsc -b && vite build && node scripts/build-cache.mjs",
    "check": "pnpm lint && tsc -b && node --test tests/*.test.ts",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "start": "node scripts/serve.mjs",
    "lint": "oxlint ."
  },
  "dependencies": {
    "phaser": "3.90.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
