{
  "name": "lanternwake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run vite",
    "build": "tsc -b && vite build && node scripts/build-cache.mjs",
    "check": "pnpm lint && tsc -b && node --test tests/*.test.ts",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "start": "node scripts/serve.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.1.3",
    "@aranlucas/oxlint-plugin-anti-slop": "0.1.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "0.15.7",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1"
}
