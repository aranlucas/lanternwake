{
  "name": "lanternwake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "portless run vite",
    "build": "tsc -b && vite build && node scripts/build-cache.mjs",
    "check": "pnpm lint && tsc -b && pnpm test",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "node scripts/serve.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --config oxfmt.config.ts --write",
    "format:check": "oxfmt --config oxfmt.config.ts --check"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.2.2",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "0.15.8",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --config oxfmt.config.ts --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --config oxfmt.config.ts --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0"
}
